@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Access Denied
                    </h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-warning">
                            <strong>@ViewBag.ErrorMessage</strong>
                        </div>
                    }
                    
                    @if (ViewBag.UserRoles != null)
                    {
                        <p><strong>Your current roles:</strong> @ViewBag.UserRoles</p>
                    }
                    else
                    {
                        <p><strong>You currently have no roles assigned.</strong></p>
                    }

                    <h5>What you can do:</h5>
                    <ul>
                        <li>Contact an administrator to assign you the appropriate role</li>
                        <li>If you're a patient, you need the "Patient" role</li>
                        <li>If you're a staff member, you need one of: "FrontOffice", "Doctor", "DentalHygienist", or "Administrator"</li>
                    </ul>

                    <div class="mt-4">
                        <p><strong>Default Admin Account (for testing):</strong></p>
                        <ul>
                            <li>Email: admin@contosodentalclinic.com</li>
                            <li>Password: (configured in appsettings.json - DefaultAdmin:Password)</li>
                        </ul>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="fas fa-home"></i> Go Home
                    </a>
                    <a href="@Url.Action("Index", "Appointments")" class="btn btn-secondary">
                        <i class="fas fa-calendar"></i> View Appointments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>