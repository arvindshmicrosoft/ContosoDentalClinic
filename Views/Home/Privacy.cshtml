@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">@ViewData["Title"]</h1>
            
            <div class="alert alert-info" role="alert">
                <i class="fa fa-info-circle"></i>
                <strong>Effective Date:</strong> January 1, 2024 | <strong>Last Updated:</strong> October 10, 2025
            </div>
            
            <div class="card">
                <div class="card-body">
                    <h2 class="h4 text-primary mb-3">1. Introduction</h2>
                    <p>
                        Contoso University Dental Clinic ("we," "us," or "our") is committed to protecting the privacy and security of our patients' 
                        personal health information (PHI). This Privacy Policy explains how we collect, use, disclose, and protect your information 
                        in accordance with the Health Insurance Portability and Accountability Act (HIPAA) and other applicable privacy laws.
                    </p>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">2. Information We Collect</h2>
                    <h3 class="h6 mb-2">Personal Health Information (PHI)</h3>
                    <ul>
                        <li>Demographic information (name, address, phone number, email, date of birth)</li>
                        <li>Medical and dental history</li>
                        <li>Treatment records and clinical notes</li>
                        <li>Diagnostic images (X-rays, photographs)</li>
                        <li>Insurance information</li>
                        <li>Payment and billing information</li>
                    </ul>
                    
                    <h3 class="h6 mb-2 mt-3">Technical Information</h3>
                    <ul>
                        <li>Website usage data and analytics</li>
                        <li>Login credentials and account information</li>
                        <li>IP addresses and browser information</li>
                        <li>Appointment scheduling data</li>
                    </ul>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">3. How We Use Your Information</h2>
                    <div class="row">
                        <div class="col-md-6">
                            <h3 class="h6 mb-2">Treatment</h3>
                            <ul>
                                <li>Providing dental care and services</li>
                                <li>Coordinating care with other healthcare providers</li>
                                <li>Maintaining medical records</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h3 class="h6 mb-2">Payment</h3>
                            <ul>
                                <li>Processing insurance claims</li>
                                <li>Billing and collections</li>
                                <li>Financial assistance programs</li>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h3 class="h6 mb-2">Healthcare Operations</h3>
                            <ul>
                                <li>Quality assurance and improvement</li>
                                <li>Training healthcare professionals</li>
                                <li>Appointment scheduling and reminders</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h3 class="h6 mb-2">Legal Requirements</h3>
                            <ul>
                                <li>Compliance with state and federal regulations</li>
                                <li>Public health reporting</li>
                                <li>Legal proceedings when required</li>
                            </ul>
                        </div>
                    </div>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">4. Information Sharing and Disclosure</h2>
                    <p>We may share your information in the following circumstances:</p>
                    <ul>
                        <li><strong>With Your Consent:</strong> We will share information when you have given written authorization</li>
                        <li><strong>Healthcare Providers:</strong> For coordinated care, referrals, and consultations</li>
                        <li><strong>Insurance Companies:</strong> For claims processing and prior authorizations</li>
                        <li><strong>Legal Requirements:</strong> When required by law, court orders, or regulatory agencies</li>
                        <li><strong>Public Health:</strong> For disease prevention and public health activities</li>
                        <li><strong>Emergency Situations:</strong> To prevent serious threat to health or safety</li>
                    </ul>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">5. Your Privacy Rights</h2>
                    <p>Under HIPAA, you have the following rights regarding your health information:</p>
                    <div class="row">
                        <div class="col-md-6">
                            <ul>
                                <li><strong>Access:</strong> Request copies of your health records</li>
                                <li><strong>Amendment:</strong> Request corrections to your health information</li>
                                <li><strong>Restriction:</strong> Request limits on how we use or share your information</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul>
                                <li><strong>Alternative Communication:</strong> Request communication in a specific way or location</li>
                                <li><strong>Accounting:</strong> Request a list of disclosures we have made</li>
                                <li><strong>Notification:</strong> Be notified of any breaches of your information</li>
                            </ul>
                        </div>
                    </div>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">6. Data Security</h2>
                    <p>We implement comprehensive security measures to protect your information:</p>
                    <ul>
                        <li><strong>Physical Safeguards:</strong> Secure facilities, locked file cabinets, restricted access</li>
                        <li><strong>Technical Safeguards:</strong> Encrypted data transmission, secure databases, access controls</li>
                        <li><strong>Administrative Safeguards:</strong> Staff training, privacy policies, incident response procedures</li>
                        <li><strong>Network Security:</strong> Firewalls, intrusion detection, regular security assessments</li>
                    </ul>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">7. Website and Online Services</h2>
                    <p>Our website and patient portal are designed with privacy in mind:</p>
                    <ul>
                        <li>Secure HTTPS encryption for all data transmission</li>
                        <li>Strong password requirements and multi-factor authentication options</li>
                        <li>Automatic session timeouts for inactive accounts</li>
                        <li>Regular security updates and monitoring</li>
                    </ul>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">8. Third-Party Services</h2>
                    <p>We may use trusted third-party services that have signed Business Associate Agreements (BAAs) with us:</p>
                    <ul>
                        <li>Electronic health record systems</li>
                        <li>Insurance verification services</li>
                        <li>Payment processing companies</li>
                        <li>Cloud storage providers</li>
                        <li>Communication and appointment scheduling platforms</li>
                    </ul>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">9. Data Retention</h2>
                    <p>
                        We retain your health information in accordance with state and federal regulations, typically for a minimum of 
                        7 years after your last visit for adults, and until age 21 or 7 years after the last visit (whichever is longer) 
                        for minors. Some records may be retained longer as required by law or for legitimate business purposes.
                    </p>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">10. Children's Privacy</h2>
                    <p>
                        We take special care to protect the privacy of minors (under 18 years old). Parent or guardian consent is 
                        required for treatment and information sharing. We comply with all applicable laws regarding minors' privacy rights.
                    </p>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">11. Changes to This Policy</h2>
                    <p>
                        We may update this Privacy Policy from time to time. We will notify patients of any material changes through 
                        our website, patient portal, or by mail. The effective date at the top of this policy indicates when it was last updated.
                    </p>
                    
                    <h2 class="h4 text-primary mb-3 mt-4">12. Contact Information</h2>
                    <p>If you have questions about this Privacy Policy or want to exercise your privacy rights, please contact us:</p>
                    
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Privacy Officer</h5>
                                    <p class="card-text">
                                        <strong>Contoso University Dental Clinic</strong><br>
                                        123 University Drive<br>
                                        Campus City, State 12345<br>
                                        <strong>Phone:</strong> (555) 123-4567<br>
                                        <strong>Email:</strong> privacy@dentalclinic.edu
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">File a Complaint</h5>
                                    <p class="card-text">
                                        <strong>U.S. Department of Health and Human Services</strong><br>
                                        Office for Civil Rights<br>
                                        200 Independence Avenue, S.W.<br>
                                        Washington, D.C. 20201<br>
                                        <strong>Phone:</strong> 1-877-696-6775<br>
                                        <strong>Website:</strong> www.hhs.gov/ocr/privacy/
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="alert alert-success mt-4" role="alert">
                        <i class="fa fa-shield"></i>
                        <strong>Your privacy is important to us.</strong> We are committed to protecting your health information and maintaining your trust.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
